# Sinel - Signal TLS Proxy Environment Variables Configuration
# Copy this file to `.env` to customize settings for local running or Docker deployment.

# ==============================================================================
# Server Network Settings
# ==============================================================================
# Internal listening port (default: 8080)
PORT=8080

# Internal listening host address (default: 0.0.0.0)
HOST=0.0.0.0

# Logging level: sinel=trace | sinel=debug | sinel=info | sinel=warn | sinel=error
RUST_LOG=sinel=info,warn

# ==============================================================================
# Signal Domain Whitelist Settings
# ==============================================================================
# Allow all official Signal domains and subdomains (*.signal.org, *.voip.signal.org)
ALLOW_ALL_SIGNAL_SUBDOMAINS=true

# Optional comma-separated list of extra allowed destination domains
# EXTRA_ALLOWED_DOMAINS=example.com,proxy.example.com

# ==============================================================================
# HTTP Camouflage & Dashboard Routing Settings
# ==============================================================================
# Status code for the root path ('/'): 302 or 404
# - "302": Redirects root requests to REDIRECT_URL / MASKED_URL
# - "404": Responds with 404 Not Found on root
# - Unset or when STATE_PATH is "/": Serves the Web UI dashboard on root (backward compatible)
# ROOT_STATUS_CODE=302

# Destination URL when ROOT_STATUS_CODE is 302 (default: https://www.google.com)
# REDIRECT_URL=https://www.google.com

# Path where the Web UI dashboard is served (default: /state)
# Can be customized to any secret path, e.g. /my-secret-proxy
# STATE_PATH=/state
